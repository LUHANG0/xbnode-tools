+package xray
+
+// Keep counters held by an old xray stream usable after its user is retired.
+// The registry forgets the counter, but its late Add calls forward to the same
+// ledger. A re-added ID receives a fresh counter without losing either tail.
+import (
+	"context"
+	"fmt"
+	appstats "github.com/xtls/xray-core/app/stats"
+	"github.com/xtls/xray-core/features/stats"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+)
+
+type trafficLedger struct {
+	mu      sync.Mutex
+	pending map[int][2]int64
+}
+
+func newTrafficLedger() *trafficLedger { return &trafficLedger{pending: make(map[int][2]int64)} }
+func (l *trafficLedger) add(uid, dir int, n int64) {
+	if n <= 0 {
+		return
+	}
+	l.mu.Lock()
+	v := l.pending[uid]
+	v[dir] += n
+	l.pending[uid] = v
+	l.mu.Unlock()
+}
+func (l *trafficLedger) drain() map[int][2]int64 {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	p := l.pending
+	l.pending = make(map[int][2]int64)
+	return p
+}
+
+type ledgerCounter struct {
+	value    atomic.Int64
+	owner    *trafficStatsManager
+	uid, dir int
+	detached bool
+}
+
+func (c *ledgerCounter) Value() int64      { return c.value.Load() }
+func (c *ledgerCounter) Set(n int64) int64 { return c.value.Swap(n) }
+func (c *ledgerCounter) Add(n int64) int64 {
+	m := c.owner
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	if c.detached {
+		m.ledger.add(c.uid, c.dir, n)
+	}
+	return c.value.Add(n)
+}
+
+type trafficStatsManager struct {
+	stats.Manager
+	mu           sync.RWMutex
+	counters     map[string]*ledgerCounter
+	ledger       *trafficLedger
+	currentUsers map[int]bool
+	configured   bool
+}
+
+func newTrafficStatsManager(base stats.Manager, l *trafficLedger) *trafficStatsManager {
+	if l == nil {
+		l = newTrafficLedger()
+	}
+	return &trafficStatsManager{Manager: base, counters: make(map[string]*ledgerCounter), ledger: l}
+}
+func trafficCounterID(name string) (uid, dir int, ok bool) {
+	parts := strings.Split(name, ">>>")
+	if len(parts) != 4 || parts[0] != "user" || parts[2] != "traffic" {
+		return
+	}
+	id := strings.TrimPrefix(parts[1], "user@")
+	uid, e := strconv.Atoi(id)
+	if e != nil || uid <= 0 {
+		return 0, 0, false
+	}
+	if parts[3] == "uplink" {
+		return uid, 0, true
+	}
+	if parts[3] == "downlink" {
+		return uid, 1, true
+	}
+	return 0, 0, false
+}
+func (m *trafficStatsManager) RegisterCounter(name string) (stats.Counter, error) {
+	uid, dir, ok := trafficCounterID(name)
+	if !ok {
+		return m.Manager.RegisterCounter(name)
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.counters[name] != nil {
+		return nil, fmt.Errorf("counter exists")
+	}
+	c := &ledgerCounter{owner: m, uid: uid, dir: dir}
+	if m.configured && !m.currentUsers[uid] {
+		c.detached = true
+		return c, nil
+	}
+	m.counters[name] = c
+	return c, nil
+}
+func (m *trafficStatsManager) GetCounter(name string) stats.Counter {
+	_, _, ok := trafficCounterID(name)
+	if !ok {
+		return m.Manager.GetCounter(name)
+	}
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	if c := m.counters[name]; c != nil {
+		return c
+	}
+	return nil
+}
+func (m *trafficStatsManager) UnregisterCounter(name string) error {
+	_, _, ok := trafficCounterID(name)
+	if !ok {
+		return m.Manager.UnregisterCounter(name)
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if c := m.counters[name]; c != nil {
+		m.detach(name, c)
+	}
+	return nil
+}
+func (m *trafficStatsManager) detach(name string, c *ledgerCounter) {
+	c.detached = true
+	m.ledger.add(c.uid, c.dir, c.value.Swap(0))
+	delete(m.counters, name)
+}
+func (m *trafficStatsManager) retain(users map[int]bool) {
+	m.mu.Lock()
+	m.currentUsers = users
+	m.configured = true
+	defer m.mu.Unlock()
+	for name, c := range m.counters {
+		if !users[c.uid] {
+			m.detach(name, c)
+		}
+	}
+}
+func (m *trafficStatsManager) drain() map[int][2]int64 {
+	m.mu.Lock()
+	for _, c := range m.counters {
+		m.ledger.add(c.uid, c.dir, c.value.Swap(0))
+	}
+	m.mu.Unlock()
+	return m.ledger.drain()
+}
+
+// xrayCreationMu serializes this temporary build context and dispatcher capture.
+var creationLedger *trafficLedger
+
+func init() {
+	typ := reflect.TypeOf((*appstats.Config)(nil))
+	orig := typeCreatorRegistry[typ]
+	typeCreatorRegistry[typ] = func(ctx context.Context, cfg interface{}) (interface{}, error) {
+		base, err := orig(ctx, cfg)
+		if err != nil {
+			return nil, err
+		}
+		return newTrafficStatsManager(base.(stats.Manager), creationLedger), nil
+	}
+}
