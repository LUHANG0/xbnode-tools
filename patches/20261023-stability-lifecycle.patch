+		t.Fatal(n)
+	}
+	if d.connCount.Load() != 1 {
+		t.Fatal(d.connCount.Load())
+	}
+	d.closeEmail(userEmail(2), true)
+	if d.connCount.Load() != 0 {
+		t.Fatal("connections retained")
+	}
+}
