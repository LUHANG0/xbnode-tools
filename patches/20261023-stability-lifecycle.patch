+func TestLedgerRetirementLateBytesAndSameID(t *testing.T) {
+	m := newTrafficStatsManager(newStatsManager(t), nil)
+	c, err := m.RegisterCounter(counterName(1, "uplink"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Add(10)
+	if got := m.drain()[1][0]; got != 10 {
+		t.Fatal(got)
+	}
+	m.retain(nil)
+	if len(m.counters) != 0 {
+		t.Fatal("retained counter")
+	}
+	c.Add(7)
+	m.retain(map[int]bool{1: true})
+	newer, _ := m.RegisterCounter(counterName(1, "uplink"))
+	newer.Add(4)
+	if got := m.drain()[1][0]; got != 11 {
+		t.Fatal(got)
+	}
+	m.retain(nil)
+	late, _ := m.RegisterCounter(counterName(1, "downlink"))
+	late.Add(9)
+	if len(m.counters) != 0 {
+		t.Fatal("late registration retained retired user")
+	}
+	if m.drain()[1][1] != 9 {
+		t.Fatal("late registration tail lost")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 1000; j++ {
+				c.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	if got := m.drain()[1][0]; got != 8000 {
+		t.Fatal(got)
+	}
+	if len(m.counters) != 0 {
+		t.Fatal("unbounded counter registry")
+	}
+}
+func TestUnlimitedTableConvergesAndLimitTransition(t *testing.T) {
+	d := newTestDispatcher()
+	for i := 0; i < 10000; i++ {
+		email := userEmail(i + 1)
+		if d.checkDeviceLimit(email, "203.0.113.1", false) {
+			t.Fatal("unlimited rejected")
+		}
+		d.delConn(email, "203.0.113.1")
+	}
+	n := 0
+	d.unlimitedIPs.Range(func(_, _ interface{}) bool { n++; return true })
+	if n != 0 {
+		t.Fatal(n)
+	}
+	email := userEmail(1)
+	d.UpdateLimits(map[string]int{email: 1}, nil, nil)
+	d.checkDeviceLimit(email, "203.0.113.1", true)
+	d.UpdateLimits(map[string]int{email: 1}, map[string]int{email: 1}, nil)
+	if !d.checkDeviceLimit(email, "203.0.113.2", true) {
+		t.Fatal("transition lost occupied IP")
+	}
+	d.delConn(email, "203.0.113.1")
+	if d.checkDeviceLimit(email, "203.0.113.2", false) {
+		t.Fatal("slot not released")
+	}
+	d.delConn(email, "203.0.113.2")
+}
+func TestRevocationInterruptsOnlyExactUserAndPreservesReader(t *testing.T) {
+	d := newTestDispatcher()
+	d.UpdateLimits(map[string]int{userEmail(1): 1, userEmail(2): 2}, nil, nil)
+	for _, id := range []int{1, 2} {
+		email := userEmail(id)
+		d.checkDeviceLimit(email, "203.0.113.1", true)
+		reader := &nopReader{}
+		link := &transport.Link{Reader: reader, Writer: &testWriter{}}
+		_ = link
+		// Use existing synthetic writer whose Interrupt has no dependency on a real pipe.
+		link.Writer = &testWriter{}
+		d.trackLink(context.Background(), link, email, "203.0.113.1", true)
+		if link.Reader != reader {
+			t.Fatal("reader wrapped")
