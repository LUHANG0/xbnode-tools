+++ b/internal/kernel/singbox/retirement_test.go
@@ -0,0 +1,65 @@
+package singbox
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestRetiredUsersConverge(t *testing.T) {
+	ct := NewConnTracker(0)
+	for i := 1; i <= 10000; i++ {
+		ct.SetUserMap(map[string]int{fmt.Sprint(i): i})
+	}
+	if len(ct.users) != 1 {
+		t.Fatalf("retained %d users for one current user", len(ct.users))
+	}
+}
+func TestCloseUUIDActuallyClosesOnlyMatchingTCPAndUDP(t *testing.T) {
+	ct := NewConnTracker(0)
+	ct.SetUserMap(map[string]int{"old": 1, "valid": 2})
+	a := ct.RoutedConnection(nil, &testConn{}, testInboundContext("old", "203.0.113.1"), nil, nil)
+	b := ct.RoutedConnection(nil, &testConn{}, testInboundContext("valid", "203.0.113.2"), nil, nil)
+	defer b.Close()
+	defer a.Close()
+	if n := ct.CloseByUUID("old"); n != 1 {
+		t.Fatalf("closed=%d", n)
+	}
+	if ct.ActiveCount() != 1 {
+		t.Fatalf("active=%d", ct.ActiveCount())
+	}
+}
+
+func TestRetiredTailAndReaddedID(t *testing.T) {
+	ct := NewConnTracker(0)
+	ct.SetUserMap(map[string]int{"old": 1})
+	c, _ := routeLimited(ct, false, "old", "203.0.113.1")
+	tc := c.(*trackedConn)
+	callback := tc.makeCountFunc(&tc.us.upload)
+	callback(10)
+	ct.SetUserMap(map[string]int{"new": 1})
+	if ct.ActiveCount() != 0 {
+		t.Fatal("old identity retained")
+	}
+	a, _, _ := ct.GetUserTraffic()
+	if a[1][0] != 10 {
+		t.Fatal(a)
+	}
+	ct.SetUserMap(nil)
+	ct.GetUserTraffic()
+	if len(ct.users) != 0 {
+		t.Fatal("idle user retained")
+	}
+	callback(7) // late zero-copy completion after stats detached
+	ct.SetUserMap(map[string]int{"newer": 1})
+	d, _ := routeLimited(ct, true, "newer", "203.0.113.2")
+	defer d.Close()
+	pc := d.(*trackedPacketConn)
+	pc.tracker.countBytes(pc.us, pc.userID, false, 4)
+	a, _, _ = ct.GetUserTraffic()
+	if a[1][0] != 11 {
+		t.Fatalf("tail+readded traffic=%v", a)
+	}
+	if n := ct.CloseByUUID("newer"); n != 1 || ct.ActiveCount() != 0 {
+		t.Fatal("UDP not revoked")
+	}
+}
