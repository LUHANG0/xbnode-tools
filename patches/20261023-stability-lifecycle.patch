+package service
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// One node/panel-specific local outbox. The panel has no idempotency key, so
+// a timeout after server acceptance can still repeat a report (at-least-once).
+func (s *Service) spoolPath() string {
+	if s.cfg == nil || s.cfg.Kernel.ConfigDir == "" {
+		return ""
+	}
+	id := fmt.Sprintf("%s|%d|%s", s.cfg.Panel.URL, s.cfg.Panel.NodeID, s.cfg.InstanceID)
+	return filepath.Join(s.cfg.Kernel.ConfigDir, fmt.Sprintf("pending-traffic-%x.json", sha256.Sum256([]byte(id))))
+}
+func (s *Service) saveTraffic(data map[int][2]int64) error {
+	p := s.spoolPath()
+	if p == "" {
+		return nil
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+		return err
+	}
+	raw, err := json.Marshal(data)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(p), ".traffic-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(raw); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(f.Name(), p)
+}
+func (s *Service) loadTraffic() error {
+	p := s.spoolPath()
+	if p == "" {
+		return nil
+	}
+	raw, err := os.ReadFile(p)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var pending map[int][2]int64
+	if err = json.Unmarshal(raw, &pending); err != nil {
+		return fmt.Errorf("invalid pending traffic outbox: %w", err)
+	}
+	for uid, d := range pending {
+		if uid <= 0 || d[0] < 0 || d[1] < 0 {
+			return fmt.Errorf("invalid pending traffic outbox values")
+		}
+	}
+	s.tracker.RestoreTraffic(pending)
+	return nil
+}
+func (s *Service) clearTraffic() error {
+	p := s.spoolPath()
+	if p == "" {
+		return nil
+	}
+	err := os.Remove(p)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	return err
+}
