+// ProcessDeltas takes ownership of a kernel's drained counters. Pending data
+// survives user retirement and RestoreTraffic merges in-flight failed reports.
+func (t *Tracker) ProcessDeltas(delta map[int][2]int64, alive map[int]map[string]bool, count int) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	var in, out int64
+	for uid, d := range delta {
+		v := t.pendingTraffic[uid]
+		v[0] += d[0]
+		v[1] += d[1]
+		if v[0] > 0 || v[1] > 0 {
+			t.pendingTraffic[uid] = v
+		}
+		out += d[0]
+		in += d[1]
+	}
+	online := make(map[int]int, len(alive))
+	for uid, ips := range alive {
+		online[uid] = len(ips)
+	}
+	t.live.Store(&snapshot{aliveIPs: alive, online: online, connCount: count, inSpeed: in, outSpeed: out})
 }
 
