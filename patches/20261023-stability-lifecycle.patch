+
+func TestRealXrayLastUserRemovalCanResume(t *testing.T) {
+	for _, mode := range []string{"full", "delta"} {
+		t.Run(mode, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			port := listener.Addr().(*net.TCPAddr).Port
+			listener.Close()
+			k := xray.New(config.KernelConfig{Type: "xray", ConfigDir: t.TempDir()})
+			defer k.Stop()
+			limits := limiter.New()
+			s := &Service{kernel: k, tracker: tracker.New(), limiter: limits, speedTracker: limiter.NewSpeedTracker(limits), cert: cert.NewManager(config.CertConfig{})}
+			k.SetSpeedLimitFunc(s.speedTracker.GetLimiter)
+			k.SetDeviceLimitFunc(s.limiter.GetDeviceLimitByUUID)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: port, ListenIP: "127.0.0.1", Network: "tcp"}
+			first := []model.UserSpec{{ID: 901, UUID: "43e50a02-29dd-4d52-b315-d86f3fa14ead"}}
+			s.applyUserUpdate(context.Background(), first, "")
+			if !k.IsRunning() {
+				t.Fatal("initial empty kernel did not start")
+			}
+			s.applyUserDelta(context.Background(), "remove", first)
+			if k.IsRunning() || len(s.lastUsers) != 0 {
+				t.Fatal("last-user removal failed")
+			}
+			replacement := []model.UserSpec{{ID: 901, UUID: "05b693a3-9235-4f83-84b8-b15d8243fbb9"}}
+			if mode == "full" {
+				s.applyUserUpdate(context.Background(), replacement, "")
+			} else {
+				s.applyUserDelta(context.Background(), "add", replacement)
+			}
+			if !k.IsRunning() || len(s.lastUsers) != 1 || s.lastUsers[0].UUID != replacement[0].UUID {
+				t.Fatal("real kernel did not resume")
+			}
+			connection, err := net.DialTimeout("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)), time.Second)
+			if err != nil {
+				t.Fatal("resumed listener missing", err)
+			}
+			connection.Close()
+		})
+	}
+}
