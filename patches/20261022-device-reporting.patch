+func TestDeviceLimitRejectsLowerIPAndConcurrentNewIPs(t *testing.T) {
+	ld := newTestDispatcher()
+	email := userEmail(1)
+	ld.UpdateLimits(map[string]int{email: 1}, map[string]int{email: 1}, nil)
+	if ld.checkDeviceLimit(email, "203.0.113.20", true) {
+		t.Fatal("first source rejected")
+	}
+	if !ld.checkDeviceLimit(email, "203.0.113.10", true) {
+		t.Fatal("smaller source bypassed occupied device limit")
+	}
+	ld.delConn(email, "203.0.113.20")
+	var accepted atomic.Int64
+	var wg sync.WaitGroup
+	for i := 1; i <= 32; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if !ld.checkDeviceLimit(email, fmt.Sprintf("203.0.113.%d", i), true) {
+				accepted.Add(1)
+			}
+			ld.GetConnectionState()
+		}(i)
+	}
+	wg.Wait()
+	if got := accepted.Load(); got != 1 {
+		t.Fatalf("concurrent unique sources admitted: %d, want 1", got)
+	}
+}
