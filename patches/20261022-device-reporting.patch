+// SnapshotAliveIPs returns an independent snapshot for periodic REST reports.
+// Unlike change-only WS batches, REST reports must refresh the panel's device
+// TTL even when a long-lived connection keeps the same source IP.
+func (t *Tracker) SnapshotAliveIPs() map[int][]string {
+	s := t.live.Load()
+	result := make(map[int][]string, len(s.aliveIPs))
+	for uid, ips := range s.aliveIPs {
+		list := make([]string, 0, len(ips))
+		for ip := range ips {
+			list = append(list, ip)
+		}
+		result[uid] = list
+	}
+	return result
+}
