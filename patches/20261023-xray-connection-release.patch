diff --git a/internal/kernel/xray/device_lifecycle_test.go b/internal/kernel/xray/device_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/internal/kernel/xray/device_lifecycle_test.go
@@ -0,0 +1,67 @@
+package xray
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/transport"
+)
+
+func TestDeviceLimitTracksUDPAndReleasesOnContextEnd(t *testing.T) {
+	for _, tcp := range []bool{false, true} {
+		ld := newTestDispatcher()
+		email := userEmail(1)
+		ld.UpdateLimits(map[string]int{email: 1}, map[string]int{email: 1}, nil)
+		ctx, cancel := context.WithCancel(context.Background())
+		if ld.checkDeviceLimit(email, "203.0.113.9", tcp) {
+			t.Fatal("first IP rejected")
+		}
+		link := &transport.Link{Reader: nopReader{}, Writer: buf.Discard}
+		ld.trackLink(ctx, link, email, "203.0.113.9", tcp)
+		if !ld.checkDeviceLimit(email, "203.0.113.1", !tcp) {
+			t.Fatal("different transport bypassed full limit")
+		}
+		cancel() // Shadowsocks bridge does not close link.Writer.
+		deadline := time.Now().Add(time.Second)
+		for ld.connCount.Load() != 0 && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if ld.connCount.Load() != 0 {
+			t.Fatal("context end leaked tracked connection")
+		}
+		if ld.checkDeviceLimit(email, "203.0.113.1", !tcp) {
+			t.Fatal("context end did not release slot")
+		}
+		link.Writer.(*closeTrackingWriter).Close()
+		if ld.connCount.Load() != 0 {
+			t.Fatal("writer close released the same connection twice")
+		}
+		ld.delConn(email, "203.0.113.1")
+	}
+}
+
+func TestDeviceLimitConcurrentContextAndWriterClose(t *testing.T) {
+	ld := newTestDispatcher()
+	email := userEmail(1)
+	ld.UpdateLimits(map[string]int{email: 1}, map[string]int{email: 1}, nil)
+	for i := 0; i < 100; i++ {
+		if ld.checkDeviceLimit(email, "192.0.2.1", true) {
+			t.Fatal("slot leaked from previous iteration")
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		link := &transport.Link{Reader: nopReader{}, Writer: buf.Discard}
+		release := ld.trackLink(ctx, link, email, "192.0.2.1", true)
+		var wg sync.WaitGroup
+		wg.Add(3)
+		go func() { defer wg.Done(); cancel() }()
+		go func() { defer wg.Done(); link.Writer.(*closeTrackingWriter).Close() }()
+		go func() { defer wg.Done(); release() }()
+		wg.Wait()
+		if ld.connCount.Load() != 0 {
+			t.Fatal("connection released incorrectly")
+		}
+	}
+}
