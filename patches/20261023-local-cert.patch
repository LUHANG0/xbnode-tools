+package service
+
+import (
+ "context"
+ "testing"
+ "github.com/cedar2025/xboard-node/internal/config"
+ "github.com/cedar2025/xboard-node/internal/kernel"
+ "github.com/cedar2025/xboard-node/internal/model"
+)
+
+func TestInstallerLocalCertificateSurvivesPanelOverrides(t *testing.T) {
+ cfg := &config.Config{Cert: config.CertConfig{PreferLocal: true, CertMode: "file", CertFile: "local.pem", KeyFile: "local.key", Domain: "local.example.com"}}
+ svc := &Service{cfg: cfg}
+ remote := &model.NodeSpec{AutoTLS: true, Domain: "remote.example.com", CertConfig: &config.CertConfig{CertMode: "none"}}
+ if svc.applyRemoteOverrides(context.Background(), remote) { t.Fatal("local policy changed") }
+ if cfg.Cert.CertMode != "file" || cfg.Cert.CertFile != "local.pem" || cfg.Cert.AutoTLS || cfg.Cert.Domain != "local.example.com" { t.Fatal("panel replaced local policy") }
+}
+
+func TestInstallerLocalCertificateValidationUsesEffectivePolicy(t *testing.T) {
+ cfg := &config.Config{Kernel: config.KernelConfig{Type: "singbox"}, Cert: config.CertConfig{PreferLocal: true, CertMode: "http", Domain: "local.example.com"}}
+ remote := &model.NodeSpec{Protocol: "anytls", CertConfig: &config.CertConfig{CertMode: "dns", DNSProvider: "not-a-provider", Domain: "remote.example.com"}}
+ if err := validateNodeRuntime(cfg, []string{"anytls"}, remote, kernel.TLSCert{}); err != nil { t.Fatalf("local ACME policy rejected: %v", err) }
+ if remote.CertConfig.CertMode != "dns" { t.Fatal("validation mutated panel model") }
+ cfg.Cert.PreferLocal = false
+ if err := validateNodeRuntime(cfg, []string{"anytls"}, remote, kernel.TLSCert{}); err == nil { t.Fatal("default panel-first validation unexpectedly ignored provider") }
+}
