diff --git a/internal/kernel/singbox/device_limit_test.go b/internal/kernel/singbox/device_limit_test.go
new file mode 100644
--- /dev/null
+++ b/internal/kernel/singbox/device_limit_test.go
@@ -0,0 +1,255 @@
+package singbox
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/buf"
+	singM "github.com/sagernet/sing/common/metadata"
+)
+
+type limitPacketConn struct{ testConn }
+
+func (c *limitPacketConn) ReadPacket(*buf.Buffer) (singM.Socksaddr, error) {
+	return singM.Socksaddr{}, io.EOF
+}
+func (c *limitPacketConn) WritePacket(*buf.Buffer, singM.Socksaddr) error { return nil }
+
+func limitTracker(limit int) *ConnTracker {
+	t := NewConnTracker(0)
+	t.SetUserMap(map[string]int{"uuid-1": 1, "uuid-2": 2})
+	t.SetDeviceLimitFunc(func(string) (int, bool) { return limit, true })
+	return t
+}
+
+// A false result means the original connection was closed and never tracked.
+func routeLimited(t *ConnTracker, udp bool, uuid, ip string) (io.Closer, bool) {
+	ctx := testInboundContext(uuid, ip)
+	if udp {
+		base := &limitPacketConn{}
+		wrapped := t.RoutedPacketConnection(context.Background(), base, ctx, nil, nil)
+		return wrapped, wrapped != base && !base.closed
+	}
+	base := &testConn{}
+	wrapped := t.RoutedConnection(context.Background(), base, ctx, nil, nil)
+	return wrapped, wrapped != base && !base.closed
+}
+
+func TestDeviceLimitRejectsLowerOrderIP(t *testing.T) {
+	for _, udp := range []bool{false, true} {
+		t.Run(fmt.Sprint("udp=", udp), func(t *testing.T) {
+			tracker := limitTracker(1)
+			first, ok := routeLimited(tracker, udp, "uuid-1", "9.9.9.9")
+			if !ok {
+				t.Fatal("first IP rejected")
+			}
+			defer first.Close()
+			second, ok := routeLimited(tracker, udp, "uuid-1", "1.1.1.1")
+			defer second.Close()
+			if ok {
+				t.Fatal("lower-sorted new IP bypassed a full device limit")
+			}
+			_, alive, count := tracker.GetUserTraffic()
+			if len(alive[1]) != 1 || count != 1 {
+				t.Fatalf("rejected IP was tracked: %v / %d", alive, count)
+			}
+		})
+	}
+}
+
+func TestDeviceLimitSameIPReferencesAndRelease(t *testing.T) {
+	for _, udp := range []bool{false, true} {
+		t.Run(fmt.Sprint("udp=", udp), func(t *testing.T) {
+			tracker := limitTracker(1)
+			first, ok := routeLimited(tracker, udp, "uuid-1", "9.9.9.9")
+			if !ok {
+				t.Fatal("first rejected")
+			}
+			second, ok := routeLimited(tracker, !udp, "uuid-1", "9.9.9.9")
+			if !ok {
+				t.Fatal("same IP rejected")
+			}
+			first.Close()
+			first.Close() // repeated close must not release the remaining ref
+			blocked, ok := routeLimited(tracker, udp, "uuid-1", "1.1.1.1")
+			blocked.Close()
+			if ok {
+				t.Fatal("IP released before its final connection closed")
+			}
+			second.Close()
+			third, ok := routeLimited(tracker, udp, "uuid-1", "1.1.1.1")
+			if !ok {
+				t.Fatal("slot not reusable after all prior connections closed")
+			}
+			third.Close()
+			_, alive, count := tracker.GetUserTraffic()
+			if len(alive) != 0 || count != 0 {
+				t.Fatalf("tracking leaked: %v / %d", alive, count)
+			}
+		})
+	}
+}
+
+func TestDeviceLimitConcurrentMixedTransports(t *testing.T) {
+	const attempts, limit = 96, 3
+	tracker := limitTracker(limit)
+	start := make(chan struct{})
+	accepted := make(chan io.Closer, attempts)
+	var wg sync.WaitGroup
+	for i := 0; i < attempts; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			conn, ok := routeLimited(tracker, i%2 == 0, "uuid-1", fmt.Sprintf("192.0.2.%d", i+1))
+			if ok {
+				accepted <- conn
+			} else {
+				conn.Close()
+			}
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	close(accepted)
+	_, alive, count := tracker.GetUserTraffic()
+	if len(alive[1]) != limit || count != limit {
+		t.Errorf("concurrent limit exceeded: %v / %d", alive, count)
+	}
+	n := 0
+	for conn := range accepted {
+		n++
+		conn.Close()
+	}
+	if n != limit {
+		t.Fatalf("accepted %d, want %d", n, limit)
+	}
+	if tracker.ActiveCount() != 0 {
+		t.Fatal("connections leaked after close")
+	}
+}
+
+func TestDeviceLimitZeroAndIndependentUsers(t *testing.T) {
+	for _, limit := range []int{0, 1} {
+		tracker := limitTracker(limit)
+		for _, uuid := range []string{"uuid-1", "uuid-2"} {
+			conn, ok := routeLimited(tracker, false, uuid, "9.9.9.9")
+			if !ok {
+				t.Fatal("independent user's first IP rejected")
+			}
+			defer conn.Close()
+		}
+		if limit == 0 {
+			conn, ok := routeLimited(tracker, true, "uuid-1", "1.1.1.1")
+			defer conn.Close()
+			if !ok {
+				t.Fatal("unlimited user was limited")
+			}
+		}
+	}
+}
+
+func TestDeviceLimitGlobalSnapshotAndLocalCeiling(t *testing.T) {
+	tracker := limitTracker(2)
+	first, _ := routeLimited(tracker, false, "uuid-1", "9.9.9.9")
+	defer first.Close()
+	tracker.UpdateGlobalDevices(map[int][]string{1: {"8.8.8.8"}})
+	blocked, ok := routeLimited(tracker, true, "uuid-1", "1.1.1.1")
+	blocked.Close()
+	if ok {
+		t.Fatal("new IP bypassed full merged state")
+	}
+	known, ok := routeLimited(tracker, true, "uuid-1", "8.8.8.8")
+	if !ok {
+		t.Fatal("known global IP should fit the local ceiling")
+	}
+	defer known.Close()
+	tracker.UpdateGlobalDevices(map[int][]string{1: {"1.1.1.1"}})
+	blocked, ok = routeLimited(tracker, false, "uuid-1", "1.1.1.1")
+	blocked.Close()
+	if ok {
+		t.Fatal("global-known IP bypassed full local ceiling")
+	}
+	known.Close()
+	tracker.globalMu.Lock()
+	tracker.globalLastUpdate = time.Now().Add(-61 * time.Second)
+	tracker.globalMu.Unlock()
+	conn, ok := routeLimited(tracker, false, "uuid-1", "1.1.1.1")
+	defer conn.Close()
+	if !ok {
+		t.Fatal("stale global state blocked an available local slot")
+	}
+}
+
+func TestDeviceLimitGlobalUpdatesConcurrentWithAdmission(t *testing.T) {
+	tracker := limitTracker(2)
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 200; i++ {
+			tracker.UpdateGlobalDevices(map[int][]string{1: {"203.0.113.1"}})
+			tracker.ClearGlobalDevices()
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 200; i++ {
+			conn, _ := routeLimited(tracker, i%2 == 0, "uuid-1", "192.0.2.1")
+			conn.Close()
+		}
+	}()
+	wg.Wait()
+	if tracker.ActiveCount() != 0 {
+		t.Fatal("connection count leaked")
+	}
+}
+
+func TestDeviceLimitForcedCloseReleasesSlot(t *testing.T) {
+	tracker := limitTracker(1)
+	conn, _ := routeLimited(tracker, false, "uuid-1", "9.9.9.9")
+	tracked := conn.(*trackedConn)
+	if !tracker.CloseByID(tracked.connID) {
+		t.Fatal("forced close failed")
+	}
+	if tracker.ActiveCount() != 0 {
+		t.Fatal("forced close did not release slot")
+	}
+	next, ok := routeLimited(tracker, false, "uuid-1", "1.1.1.1")
+	defer next.Close()
+	if !ok {
+		t.Fatal("slot unavailable after forced close")
+	}
+	conn.Close()
+	if tracker.ActiveCount() != 1 {
+		t.Fatal("duplicate close released another connection")
+	}
+}
+
+func TestDeviceLimitGlobalUnionDeduplicatesAndClearReleases(t *testing.T) {
+	tracker := limitTracker(2)
+	first, _ := routeLimited(tracker, false, "uuid-1", "9.9.9.9")
+	defer first.Close()
+	tracker.UpdateGlobalDevices(map[int][]string{1: {"9.9.9.9", "9.9.9.9"}})
+	second, ok := routeLimited(tracker, true, "uuid-1", "1.1.1.1")
+	if !ok {
+		t.Fatal("same IP in both local and global was counted twice")
+	}
+	second.Close()
+	tracker.UpdateGlobalDevices(map[int][]string{1: {"8.8.8.8"}})
+	blocked, ok := routeLimited(tracker, true, "uuid-1", "1.1.1.1")
+	blocked.Close()
+	if ok {
+		t.Fatal("full global union allowed a new IP")
+	}
+	tracker.ClearGlobalDevices()
+	second, ok = routeLimited(tracker, true, "uuid-1", "1.1.1.1")
+	defer second.Close()
+	if !ok {
+		t.Fatal("cleared global state still blocked available local slot")
+	}
+}
